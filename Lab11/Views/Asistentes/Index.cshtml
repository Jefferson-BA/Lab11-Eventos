@model IReadOnlyList<Asistente>
@{
    ViewData["Title"] = "Asistentes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Asistentes</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo asistente</a>
</div>
<div class="table-responsive">
    <table class="table table-striped">
        <thead><tr><th>Nombres</th><th>DNI</th><th>Correo</th><th>Teléfono</th><th></th></tr></thead>
        <tbody>
        @foreach (var asistente in Model)
        {
            <tr>
                <td>@asistente.Nombres</td><td>@asistente.Dni</td><td>@asistente.Correo</td><td>@asistente.Telefono</td>
                <td>
                    <form asp-action="Delete" asp-route-id="@asistente.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Desactivar este asistente?')">Desactivar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
