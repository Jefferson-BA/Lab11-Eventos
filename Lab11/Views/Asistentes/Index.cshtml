@model IReadOnlyList<Asistente>
@{
    ViewData["Title"] = "Asistentes";
}
<div class="page-heading">
    <div>
        <div class="eyebrow">Directorio</div>
        <h1>Asistentes</h1>
        <p>Administra los perfiles habilitados para inscribirse a eventos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">＋ &nbsp;Nuevo asistente</a>
</div>
@if (Model.Count == 0)
{
    <div class="empty-state">
        <span class="empty-icon">A</span>
        <h2>Directorio vacío</h2>
        <p>Registra asistentes para que puedan participar en los eventos.</p>
        <a asp-action="Create" class="btn btn-primary mt-3">Agregar asistente</a>
    </div>
}
else
{
    <div class="table-panel">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead><tr><th>Nombre completo</th><th>DNI</th><th>Correo electrónico</th><th>Teléfono</th><th>Acciones</th></tr></thead>
                <tbody>
                @foreach (var asistente in Model)
                {
                    <tr>
                        <td class="fw-semibold">@asistente.Nombres</td>
                        <td>@asistente.Dni</td>
                        <td><a href="mailto:@asistente.Correo">@asistente.Correo</a></td>
                        <td>@(string.IsNullOrWhiteSpace(asistente.Telefono) ? "—" : asistente.Telefono)</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@asistente.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Desactivar este asistente?')">Desactivar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
