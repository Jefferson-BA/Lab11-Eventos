@model Evento
@{
    ViewData["Title"] = "Desactivar evento";
}
<div class="page-heading">
    <div>
        <div class="eyebrow">Acción administrativa</div>
        <h1>Desactivar evento</h1>
        <p>Confirma que deseas retirar este evento de la agenda activa.</p>
    </div>
</div>
<section class="form-panel">
    <div class="alert alert-warning">
        El registro y sus inscripciones se conservarán. Esta acción solo marcará el evento como inactivo.
    </div>
    <div class="detail-grid">
        <div class="detail-item"><dt>Evento</dt><dd>@Model.Titulo</dd></div>
        <div class="detail-item"><dt>Fecha</dt><dd>@Model.Fecha.ToString("g")</dd></div>
        <div class="detail-item"><dt>Categoría</dt><dd>@Model.Categoria?.Nombre</dd></div>
    </div>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-outline-danger">Confirmar desactivación</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Conservar evento</a>
    </form>
</section>
