@model IReadOnlyList<EventoListaViewModel>
@{
    ViewData["Title"] = "Eventos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Eventos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo evento</a>
</div>
<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label for="categoriaId" class="form-label">Filtrar por categoría</label>
        <select id="categoriaId" name="categoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Filtrar</button></div>
    <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Título</th><th>Fecha</th><th>Categoría</th><th>Modalidad</th><th>Inscritos</th><th>Cupos</th><th></th></tr></thead>
        <tbody>
        @foreach (var evento in Model)
        {
            <tr>
                <td>@evento.Titulo</td>
                <td>@evento.Fecha.ToString("g")</td>
                <td>@evento.Categoria</td>
                <td>@evento.Modalidad</td>
                <td>@evento.InscritosConfirmados</td>
                <td>@evento.CuposDisponibles / @evento.Aforo</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@evento.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@evento.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
