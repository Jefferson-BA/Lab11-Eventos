@model IReadOnlyList<EventoListaViewModel>
@{
    ViewData["Title"] = "Eventos";
}

<div class="page-heading">
    <div>
        <div class="eyebrow">Agenda seleccionada</div>
        <h1>Eventos</h1>
        <p>Descubre próximas experiencias y administra sus cupos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">＋ &nbsp;Nuevo evento</a>
</div>
<form asp-action="Index" method="get" class="filter-panel">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label for="categoriaId" class="form-label">Explorar por categoría</label>
            <select id="categoriaId" name="categoriaId" asp-items="ViewBag.Categorias" class="form-select">
                <option value="">Todas las categorías</option>
            </select>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Aplicar filtro</button></div>
        <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
    </div>
</form>
@if (Model.Count == 0)
{
    <div class="empty-state">
        <span class="empty-icon">E</span>
        <h2>Aún no hay eventos</h2>
        <p>Prueba otra categoría o crea el primer evento de la agenda.</p>
        <a asp-action="Create" class="btn btn-primary mt-3">Crear evento</a>
    </div>
}
else
{
    <div class="table-panel">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead><tr><th>Evento</th><th>Fecha</th><th>Categoría</th><th>Modalidad</th><th>Inscritos</th><th>Cupos disponibles</th><th>Acciones</th></tr></thead>
                <tbody>
                @foreach (var evento in Model)
                {
                    <tr>
                        <td class="fw-semibold">@evento.Titulo</td>
                        <td>@evento.Fecha.ToString("g")</td>
                        <td><span class="badge-muted">@evento.Categoria</span></td>
                        <td><span class="badge-gold">@evento.Modalidad</span></td>
                        <td>@evento.InscritosConfirmados</td>
                        <td>@evento.CuposDisponibles <span class="text-muted">/ @evento.Aforo</span></td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@evento.Id" class="btn btn-sm btn-outline-primary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@evento.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
