@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="empty-state">
    <span class="empty-icon">!</span>
    <div class="eyebrow">Algo salió mal</div>
    <h1>No pudimos completar la solicitud</h1>
    <p>Ocurrió un error inesperado. Intenta nuevamente o vuelve a la agenda.</p>
    @if (Model.ShowRequestId)
    {
        <p class="mt-3">Referencia: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Eventos" asp-action="Index" class="btn btn-primary mt-3">Volver a eventos</a>
</div>
