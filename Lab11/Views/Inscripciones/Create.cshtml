@model InscripcionCrearViewModel
@{
    ViewData["Title"] = "Nueva inscripción";
}
<div class="page-heading">
    <div>
        <div class="eyebrow">Participación</div>
        <h1>Crear inscripción</h1>
        <p>Selecciona el evento y el asistente. Validaremos fechas, cupos y duplicados.</p>
    </div>
</div>
<section class="form-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-4">
            <label asp-for="EventoId" class="form-label"></label>
            <select asp-for="EventoId" asp-items="ViewBag.Eventos" class="form-select">
                <option value="0">Selecciona un evento disponible</option>
            </select>
            <span asp-validation-for="EventoId" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="AsistenteId" class="form-label"></label>
            <select asp-for="AsistenteId" asp-items="ViewBag.Asistentes" class="form-select">
                <option value="0">Selecciona un asistente</option>
            </select>
            <span asp-validation-for="AsistenteId" class="text-danger"></span>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Confirmar inscripción</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
